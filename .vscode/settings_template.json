{
    "[python]": {
        "editor.defaultFormatter": "ms-python.black-formatter"
    },
    "python.defaultInterpreterPath": ".../.venv311/bin/python",
    "ruff.interpreter": [
        ".../.venv311/bin/python"
    ],
    "search.exclude": {
        "**/venv*": true
    },
    "files.watcherExclude": {
        "**/.git/objects/**": true,
        "**/.git/subtree-cache/**": true,
        "**/node_modules/*/**": true,
        "**/.hg/store/**": true
    }
}